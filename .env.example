# =====================================================================
# Configuración del Proyecto y APIs existentes
# =====================================================================
SERVER=localhost
USER=sa
PASSWORD=secret
PORT=1433
DATABASE=empresa
DRIVER=ODBC Driver 17 for SQL Server

# Supabase (Procedimientos almacenados para reportes)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-supabase-key
TOKEN_API=tu-token-seguro

# Google Service Account (Legado - Opcional)
SERVICE_ACCOUNT=controlio-a9a2e-aa2f420e4eaa.json

# =====================================================================
# Microsoft SharePoint / Azure AD (Microsoft Graph API)
# =====================================================================
# Credenciales de la aplicación registrada en Microsoft Entra ID (portal.azure.com):
# 1. En Entra ID -> App Registrations -> New Registration
# 2. En 'Certificates & secrets' -> Generar un New client secret
# 3. En 'API permissions' -> Agregar permiso de aplicación (Application):
#    Microsoft Graph -> Files.ReadWrite.All o Sites.Selected
#    (Asegúrate de otorgar 'Grant admin consent')
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Configuración del sitio de SharePoint:
# SHAREPOINT_SITE_ID: Puede ser el ID del sitio (formato: hostname,sited-id,web-id)
# o la URL relativa del sitio (ejemplo: contoso.sharepoint.com:/sites/Operaciones:)
SHAREPOINT_SITE_ID=

# SHAREPOINT_DRIVE_ID: ID de la biblioteca de documentos (opcional; si está vacío,
# el servicio utilizará automáticamente la biblioteca principal por defecto 'Documents')
SHAREPOINT_DRIVE_ID=

# Carpeta destino dentro de SharePoint para organizar los reportes generados
SHAREPOINT_FOLDER_PATH=Reportes

# Carpeta local para guardar reportes cuando SharePoint no esté configurado o en modo offline
LOCAL_REPORTS_DIR=generated_reports
